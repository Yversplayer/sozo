# Sōzō — variables d'environnement. [SECRET] : à saisir dans l'hébergeur,
# jamais dans le dépôt. [PUBLIC] : sans danger.

# [PUBLIC] « sqlite » (développement) ou « postgres » (production)
SOZO_DB_BACKEND=sqlite
# [PUBLIC] fichier SQLite de développement
SOZO_DB_PATH=backend/sozo.db
# [SECRET] URL PostgreSQL (Supabase, pooler en mode transaction)
SOZO_DATABASE_URL=
# [PUBLIC] schéma PostgreSQL (public en production)
SOZO_PG_SCHEMA=public
# [PUBLIC] 1 en production derrière Cloudflare : HSTS, cookies Secure
SOZO_HTTPS=0
# [SECRET] secret partagé avec le Worker Cloudflare (IP réelle du visiteur)
SOZO_SECRET_PROXY=
# [PUBLIC] 1 = réglages de test (refusé sur une base distante)
SOZO_MODE_TEST=0
