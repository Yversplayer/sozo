# Sōzō — variables d'environnement. [SECRET] : à saisir dans l'hébergeur,
# jamais dans le dépôt. [PUBLIC] : sans danger.

# [PUBLIC] « sqlite » (développement) ou « postgres » (production)
SOZO_DB_BACKEND=sqlite
# [PUBLIC] fichier SQLite de développement
SOZO_DB_PATH=backend/sozo.db
# [SECRET] URL PostgreSQL (Supabase, pooler en mode transaction)
SOZO_DATABASE_URL=
# [PUBLIC] schéma PostgreSQL (public en production)
SOZO_PG_SCHEMA=public
# [PUBLIC] 1 en production derrière Cloudflare : HSTS, cookies Secure
SOZO_HTTPS=0
# [SECRET] secret partagé avec le Worker Cloudflare (IP réelle du visiteur)
SOZO_SECRET_PROXY=
# [PUBLIC] 1 = réglages de test (refusé sur une base distante)
SOZO_MODE_TEST=0

# ── E-mails ────────────────────────────────────────────────────────────────
# [PUBLIC] capture (rien ne part) | smtp | brevo
SOZO_EMAIL_MODE=capture
# [PUBLIC] adresse de contact (réponses, bas de page)
SOZO_EMAIL_CONTACT=mudeyimusimwa@gmail.com
# [PUBLIC] expéditeur ; avec Gmail SMTP, le compte Gmail lui-même
SOZO_EMAIL_FROM=mudeyimusimwa@gmail.com
# [PUBLIC] Gmail : smtp.gmail.com, 587, starttls
SOZO_SMTP_HOST=smtp.gmail.com
SOZO_SMTP_PORT=587
SOZO_SMTP_TLS=starttls
SOZO_SMTP_USER=mudeyimusimwa@gmail.com
# [SECRET] « mot de passe d'application » Google (16 lettres), PAS le mot de passe du compte
SOZO_SMTP_PASSWORD=
# [SECRET] si SOZO_EMAIL_MODE=brevo
SOZO_BREVO_API_KEY=
# [PUBLIC] adresse publique du site (liens des e-mails)
SOZO_APP_URL=http://localhost:4385

# ── Notifications d'appareil (Web Push) ────────────────────────────────────
# Générer : backend_venv/bin/python backend/tools/vapid.py
SOZO_VAPID_PUBLIC=
# [SECRET]
SOZO_VAPID_PRIVE=
# [PUBLIC] 1 = tâches périodiques dans le serveur web (sinon : tâche planifiée tools/taches.py)
SOZO_TACHES_INTEGREES=0
# [PUBLIC] jours de conservation des manuscrits d'origine après import
SOZO_CONSERVATION_MANUSCRITS_JOURS=90

# ── Sauvegardes ────────────────────────────────────────────────────────────
# [SECRET] clé de chiffrement des sauvegardes (tools/sauvegarde.py cle).
# À garder AUSSI hors du serveur : perdue, les sauvegardes sont irrécupérables.
SOZO_CLE_SAUVEGARDE=
